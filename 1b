solve the following statements with the help of sql queries. 
1) define a function to calculate the number of absent days for a given student in a specific month and year. 
delimiter //
create function getabsentdays(
    sid int,
    month_name varchar(20)
)
returns int
deterministic
begin
    declare present_days int;
    declare total_days int default 30;

    select no_of_days_present into present_days
    from attendance
    where student_id = sid and month = month_name;

    return (total_days - ifnull(present_days, 0));
end //
delimiter ;

select getabsentdays(101, 'march') as absent_days;

2) combine a list of all students in class 'se' who have scored more than 20 marks in any subject. 
select distinct s.student_id, s.name
from students s
join classes c on s.class_id = c.class_id
join marks m on s.student_id = m.student_id
where c.class_name = 'se'
and m.marks > 20;

3) identify students whose names have the second letter as 'a'. 
select name
from students
where name like '_a%';

4) calculate the average attendance percentage for all students in class 'se' for the month of march. 
select 
    avg((a.no_of_days_present / 30) * 100) as avg_attendance_percentage
from attendance a
join students s on a.student_id = s.student_id
join classes c on s.class_id = c.class_id
where c.class_name = 'se'
and a.month = 'march';

5) list the names of students who have scored below 10 marks in any subject. 
select distinct s.name
from students s
join marks m on s.student_id = m.student_id
where m.marks < 10;



