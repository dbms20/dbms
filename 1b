7) use a cursor to display names of all students one by one. 

delimiter //
create procedure displaystudents()
begin
    declare done int default false;
    declare s_name varchar(50);

    declare cur cursor for 
        select name from students;

    declare continue handler for not found set done = true;

    open cur;

    read_loop: loop
        fetch cur into s_name;
        
        if done then
            leave read_loop;
        end if;

        select s_name as student_name;
    end loop;

    close cur;
end //

delimiter ;

call displaystudents();









