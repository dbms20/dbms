solve the following statements with the help of sql queries. 
1) retrieve student names along with their class names. 

select s.name, c.class_name
from students s
join classes c on s.class_id = c.class_id;

2) display highest marks scored in each subject. 

select subject_id, max(marks) as highest_marks
from grades
group by subject_id;

3) create a trigger to prevent insertion of negative marks. 
delimiter //

create trigger prevent_negative_marks
before insert on grades
for each row
begin
    if new.marks < 0 then
        signal sqlstate '45000'
        set message_text = 'marks cannot be negative';
    end if;
end //

delimiter ;

show triggers;

4) create a procedure to find total number of students in a class. 

delimiter //

create procedure getstudentcount(in cid int)
begin
    select count(*) as total_students
    from students
    where class_id = cid;
end //

delimiter ;

call getstudentcount(1);

5) display students whose total marks are greater than 80. 

select s.name, sum(g.marks) as total_marks
from students s
join grades g on s.student_id = g.student_id
group by s.name
having sum(g.marks) > 80;

