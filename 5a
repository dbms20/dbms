7. create a trigger to prevent scheduling appointments in the past. 
delimiter //

create trigger prevent_past_appointment
before insert on appointments
for each row
begin
    if new.appointment_date < curdate() then
        signal sqlstate '45000'
        set message_text = 'cannot schedule appointment in the past';
    end if;
end //

