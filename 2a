write and execute mysql queries for the following. 
1. find the total duration of workouts for each user for a particular day. 
select 
    user_id,
    sum(duration_in_minutes) as total_duration
from workouts
where date = '2026-03-10'
group by user_id;


2. create a stored procedure to retrieve all workouts for a specific user within a given date range. 
delimiter //

create procedure getuserworkouts(
    in uid int,
    in start_date date,
    in end_date date
)
begin
    select *
    from workouts
    where user_id = uid
    and date between start_date and end_date;
end //

delimiter ;
call getuserworkouts(101, '2026-03-01', '2026-03-31');

3. retrieve a list of users along with the total number of workouts they have logged. 

select 
    u.name,
    count(w.workout_id) as total_workouts
from users u
left join workouts w on u.user_id = w.user_id
group by u.name;

4. create a view that shows a summary of each user's workouts. this should include the user's name, workout type and total duration of all workouts. 
create view workout_summary as
select 
    u.name,
    w.workout_type,
    sum(w.duration_in_minutes) as total_duration
from users u
join workouts w on u.user_id = w.user_id
group by u.name, w.workout_type;

select * from workout_summary;




