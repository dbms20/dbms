select distinct u.name
from users u
join users_goal ug on u.user_id = ug.user_id
where ug.goal_type = 'weight loss';

6. create a trigger to prevent insertion of workouts with end time earlier than start time. 


delimiter //
create trigger check_workout_time
before insert on workouts
for each row
begin
    if new.end_time < new.start_time then
        signal sqlstate '45000'
        set message_text = 'end time cannot be earlier than start time';
    end if;
end //

delimiter ;

show triggers;


