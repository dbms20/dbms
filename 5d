6. create a function that counts how many appointments a patient has. 
delimiter //
create function getappointmentcount(pid int)
returns int
deterministic
begin
    declare total int;

    select count(*)
    into total
    from appointments
    where patientid = pid;

    return total;
end //
delimiter ;
select getappointmentcount(101) as total_appointments;

