solve the following statements with the help of sql queries 
1. list all doctors who work in the cardiology department. 
select d.doctorname
from doctors d
join departments dep on d.departmentid = dep.departmentid
where dep.departmentname = 'cardiology';

2. list patients between 30 and 50 years old. 

select patientname,
       timestampdiff(year, dob, curdate()) as age
from patients
where timestampdiff(year, dob, curdate()) between 30 and 50;

3. who are the 3 oldest patients in the hospital? 


select *
from patients
order by dob asc
limit 3;

4. create a procedure that returns patient counts by age groups. 

delimiter //

create procedure patientagegroups()
begin
    select 
        case 
            when timestampdiff(year, dob, curdate()) < 18 then 'child'
            when timestampdiff(year, dob, curdate()) between 18 and 60 then 'adult'
            else 'senior'
        end as age_group,
        count(*) as total_patients
    from patients
    group by age_group;
end //

delimiter ;
call patientagegroups();


