3) create a trigger to log deleted customer records into a backup table. 

create table customers_backup (
    customer_id int,
    name varchar(50),
    contact_number varchar(15),
    deleted_at timestamp default current_timestamp
);

delimiter //
create trigger backup_customer_delete
before delete on customers
for each row
begin
    insert into customers_backup(customer_id, name, contact_number)
    values (old.customer_id, old.name, old.contact_number);
end //

