write and execute the sql queries for the following 
1. find the total sales for each menu category. 

select 
    m.category,
    sum(oi.quantity * oi.unit_price) as total_sales
from orderitems oi
join menu m on oi.item_id = m.item_id
group by m.category;

2. create a stored procedure to retrieve the details of a specific order given its order id. 
delimiter //

create procedure getorderdetails(in oid int)
begin
    select 
        o.order_id,
        c.name as customer_name,
        m.item_name,
        oi.quantity,
        oi.unit_price
    from orders o
    join customers c on o.customer_id = c.customer_id
    join orderitems oi on o.order_id = oi.order_id
    join menu m on oi.item_id = m.item_id
    where o.order_id = oid;
end //	

delimiter ;

call getorderdetails(1);


