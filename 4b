write and execute the sql queries for the following 
1. find the total quantity in stock for each product across all warehouses. 
select 
    p.name,
    sum(i.quantity_in_stock) as total_stock
from products p
join inventory i on p.product_id = i.product_id
group by p.name;


2. calculate the average price of products in each category. 
select 
    c.category_name,
    avg(p.price) as avg_price
from products p
join categories c on p.category_id = c.category_id
group by c.category_name;

3. combine a list of products in the 'refrigerators' category and a list of products that have a price greater than 1000. 

select name, price
from products
where category_id in (
    select category_id 
    from categories 
    where category_name = 'refrigerators'
)
or price > 1000;

4. create a cursor to loop through products and display their total stock. 
delimiter //

create procedure productstockcursor()
begin
    declare done int default false;
    declare pname varchar(50);
    declare total int;

    declare cur cursor for
        select p.name, sum(i.quantity_in_stock)
        from products p
        join inventory i on p.product_id = i.product_id
        group by p.name;

    declare continue handler for not found set done = true;

    open cur;

    read_loop: loop
        fetch cur into pname, total;

        if done then
            leave read_loop;
        end if;

        select pname as product_name, total as total_stock;
    end loop;

    close cur;
end //

delimiter ;

call productstockcursor();

5. show warehouses where total stock is less than 50. 
select 
    w.warehouse_name,
    sum(i.quantity_in_stock) as total_stock
from warehouses w
join inventory i on w.warehouse_id = i.warehouse_id
group by w.warehouse_name
having sum(i.quantity_in_stock) < 50;

