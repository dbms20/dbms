write and execute the sql queries for the following 
1) calculate the total price of each item in order_id 1. 

select 
    item_id,
    quantity,
    unit_price,
    (quantity * unit_price) as total_price
from orderitems
where order_id = 1;

2) find the names of all customers who have placed an order 

select distinct c.name
from customers c
join orders o on c.customer_id = o.customer_id;

3) find total number of customers registered in the system. 
select count(*) as total_customers
from customers;

4) find the names of customers who have placed orders containing items from both the 'pizza' and 'burgers' categories. 

select c.name
from customers c
join orders o on c.customer_id = o.customer_id
join orderitems oi on o.order_id = oi.order_id
join menu m on oi.item_id = m.item_id
where m.category in ('pizza', 'burgers')
group by c.name
having count(distinct m.category) = 2;

5) find the menu items that have never been included in any order. 
select m.item_name
from menu m
left join orderitems oi on m.item_id = oi.item_id
where oi.item_id is null;
6) create a function to check if an item is in a specific category. 
delimiter //

create function checkcategory(
    itemid int,
    cat varchar(50)
)
returns varchar(20)
deterministic
begin
    declare result varchar(20);

    select if(category = cat, 'yes', 'no')
    into result
    from menu
    where item_id = itemid;

    return result;
end //

delimiter ;
select checkcategory(1, 'pizza') as result;

