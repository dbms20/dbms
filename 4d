write and execute the sql queries for the following 
1) define a function to check if a product is currently out of stock (total quantity across all warehouses is zero). 
delimiter //

create function isoutofstock(pid int)
returns varchar(10)
deterministic
begin
    declare total_qty int;

    select ifnull(sum(quantity_in_stock), 0)
    into total_qty
    from inventory
    where product_id = pid;

    if total_qty = 0 then
        return 'yes';
    else
        return 'no';
    end if;
end //

delimiter ;
select isoutofstock(101) as out_of_stock;


