write and execute the sql queries for the following 
1) create a stored procedure that takes an item name, category, and price as input and inserts a new record into the menu table. 

delimiter //

create procedure addmenuitem(
    in iid int,
    in iname varchar(50),
    in icategory varchar(50),
    in iprice decimal(10,2)
)
begin
    insert into menu(item_id, item_name, category, price)
    values (iid, iname, icategory, iprice);
end //

delimiter ;
call addmenuitem(5, 'sandwich', 'fast food', 150);

2) find the highest and lowest price from the menu table, along with the names of the items. 
select item_name, price
from menu
where price = (select max(price) from menu)
   or price = (select min(price) from menu);

3) count the number of items in each category in the menu table. 

select category, count(*) as total_items
from menu
group by category;

4) calculate the average number of items per order. 
select avg(item_count) as avg_items_per_order
from (
    select order_id, sum(quantity) as item_count
    from orderitems
    group by order_id
) as temp;


5) get the names of all items in a specific order, given the order id. 
select m.item_name
from orderitems oi
join menu m on oi.item_id = m.item_id
where oi.order_id = 1;

6) find customers who have placed more than 3 orders. 
select c.name, count(o.order_id) as total_orders
from customers c
join orders o on c.customer_id = o.customer_id
group by c.name
having count(o.order_id) > 3;

7) display items whose average unit price is greater than 200. 
select m.item_name, avg(oi.unit_price) as avg_price
from orderitems oi
join menu m on oi.item_id = m.item_id
group by m.item_name
having avg(oi.unit_price) > 200;






