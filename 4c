6. create a procedure to insert a new product into the database. 
delimiter //

create procedure addproduct(
    in pid int,
    in pname varchar(50),
    in pdesc varchar(100),
    in pprice decimal(10,2),
    in cid int
)
begin
    insert into products
    values (pid, pname, pdesc, pprice, cid);
end //

delimiter ;
