5) create a trigger to insert the student’s name, old class id, new class id and timestamp automatically in student_class_history table when a student is moved to a different class. 
delimiter //

create trigger track_class_change
before update on students
for each row
begin
    if old.class_id <> new.class_id then
        insert into student_class_history
        (student_id, student_name, old_class_id, new_class_id)
        values
        (old.student_id, old.name, old.class_id, new.class_id);
    end if;
end //

delimiter ;

show triggers;

