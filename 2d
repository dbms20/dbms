4) create a view to get a summary of each user's workouts, including their name, the workout type, and the duration. 
create view user_workout_summary as
select 
    u.name,
    w.workout_type,
    sum(w.duration_in_minutes) as total_duration
from users u
join workouts w on u.user_id = w.user_id
group by u.name, w.workout_type;

