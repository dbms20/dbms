5) use a cursor to display names of all users one by one. 

delimiter //

create procedure displayusers()
begin
    declare done int default false;
    declare uname varchar(50);

    declare cur cursor for 
        select name from users;

    declare continue handler for not found set done = true;

    open cur;

    read_loop: loop
        fetch cur into uname;

        if done then
            leave read_loop;
        end if;

        select uname as user_name;
    end loop;

    close cur;
end //

delimiter ;
call displayusers();

6) create a procedure to insert a new workout record. 
delimiter //

create procedure addworkout(
    in wid int,
    in uid int,
    in wdate date,
    in wtype varchar(50),
    in st time,
    in et time,
    in dur int
)
begin
    insert into workouts
    values (wid, uid, wdate, wtype, st, et, dur);
end //

