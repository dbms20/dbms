4. create a view to show products with low stock (less than 10 units total) 
create view low_stock_products as
select 
    p.name,
    sum(i.quantity_in_stock) as total_stock
from products p
join inventory i on p.product_id = i.product_id
group by p.name
having sum(i.quantity_in_stock) < 10;

select * from low_stock_products;

5. count how many orders exist in each status (e.g., pending, shipped, delivered). 

select order_status, count(*) as total_orders
from orders
group by order_status;

6. create a trigger to prevent insertion of negative stock values. 

delimiter //

create trigger prevent_negative_stock
before insert on inventory
for each row
begin
    if new.quantity_in_stock < 0 then
        signal sqlstate '45000'
        set message_text = 'stock cannot be negative';
    end if;
end //

