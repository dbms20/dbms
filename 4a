write and execute the sql queries for the following 
1. find how many products are listed under each category. 

select c.category_name, count(p.product_id) as total_products
from categories c
left join products p on c.category_id = p.category_id
group by c.category_name;

2. create a procedure to retrieve all orders for a given customer id. 
delimiter //

create procedure getordersbycustomer(in cid int)
begin
    select *
    from orders
    where customer_id = cid;
end //

